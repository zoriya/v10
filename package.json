{
  "name": "@videojs/store",
  "type": "module",
  "version": "10.0.0-beta.26",
  "description": "Reactive state management for external systems.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/v10",
    "directory": "packages/store"
  },
  "main": "dist/default/index.js",
  "module": "dist/default/index.js",
  "types": "dist/dev/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/default/index.js"
    },
    "./html": {
      "types": "./dist/dev/html.d.ts",
      "development": "./dist/dev/html.js",
      "default": "./dist/default/html.js"
    },
    "./react": {
      "types": "./dist/dev/react.d.ts",
      "development": "./dist/dev/react.js",
      "default": "./dist/default/react.js"
    }
  },
  "peerDependencies": {
    "@videojs/element": "*",
    "react": "^18.0.0 || ^19.0.0",
    "@videojs/utils": "*"
  },
  "peerDependenciesMeta": {
    "@videojs/element": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "store",
    "media",
    "player",
    "videojs",
    "reactive"
  ]
}
